# syntax=docker/dockerfile:1.7

FROM python:3.12.10-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /build

COPY pyproject.toml LICENSE README.md ./
COPY apps ./apps
COPY packages ./packages
COPY cloud_connectors ./cloud_connectors
COPY detections ./detections
COPY compliance ./compliance

RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip "setuptools>=78.1.1" wheel \
    && /opt/venv/bin/pip install .

FROM python:3.12.10-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

# Apply available Debian security updates to the pinned base image.
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 10001 cloudsentinel \
    && useradd --system --uid 10001 --gid cloudsentinel --home-dir /app --shell /sbin/nologin cloudsentinel

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
# Harden runtime image by removing build/packaging tools (pip, setuptools, wheel, ensurepip) not needed at runtime.
RUN /opt/venv/bin/python -m pip uninstall -y setuptools wheel pip; \
    /usr/local/bin/python -m pip uninstall -y setuptools wheel pip; \
    find / -xdev \( -iname "*setuptools*" -o -iname "*pkg_resources*" -o -iname "ensurepip" \) -exec rm -rf {} + 2>/dev/null || true
COPY --chown=cloudsentinel:cloudsentinel apps ./apps
COPY --chown=cloudsentinel:cloudsentinel packages ./packages
COPY --chown=cloudsentinel:cloudsentinel cloud_connectors ./cloud_connectors
COPY --chown=cloudsentinel:cloudsentinel detections ./detections
COPY --chown=cloudsentinel:cloudsentinel compliance ./compliance

USER cloudsentinel

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "from apps.worker.celery_app import ping; assert ping()['status'] == 'pong'"

CMD ["celery", "-A", "apps.worker.celery_app:celery_app", "worker", "--loglevel=info"]
