# syntax=docker/dockerfile:1.7

FROM python:3.12.10-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /build

COPY pyproject.toml LICENSE README.md ./
COPY apps ./apps
COPY packages ./packages
COPY cloud_connectors ./cloud_connectors
COPY detections ./detections
COPY compliance ./compliance

RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && /opt/venv/bin/pip install .

FROM python:3.12.10-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

RUN groupadd --system --gid 10001 cloudsentinel \
    && useradd --system --uid 10001 --gid cloudsentinel --home-dir /app --shell /sbin/nologin cloudsentinel

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY --chown=cloudsentinel:cloudsentinel apps ./apps
COPY --chown=cloudsentinel:cloudsentinel packages ./packages
COPY --chown=cloudsentinel:cloudsentinel cloud_connectors ./cloud_connectors
COPY --chown=cloudsentinel:cloudsentinel detections ./detections
COPY --chown=cloudsentinel:cloudsentinel compliance ./compliance
COPY --chown=cloudsentinel:cloudsentinel database ./database

USER cloudsentinel

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2)"

CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
