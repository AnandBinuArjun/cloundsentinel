# =============================================================================
# CloudSentinel Environment Configuration Template (v1.0.0)
# Copy to .env for local development ONLY. Never commit .env with real secrets.
# Replace all placeholder passwords/secrets before any non-local deployment.
# =============================================================================

# Application
CLOUDSENTINEL_ENV=development
CLOUDSENTINEL_VERSION=1.0.0
CLOUDSENTINEL_LOG_LEVEL=INFO
CLOUDSENTINEL_API_HOST=127.0.0.1
CLOUDSENTINEL_API_PORT=8000
CLOUDSENTINEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CLOUDSENTINEL_READINESS_TIMEOUT_SECONDS=2.0
CLOUDSENTINEL_RATE_LIMIT_RPM=120

# PostgreSQL 16+ (local Docker Compose defaults)
# For dockerless local testing, you may use: sqlite+aiosqlite:///./cloudsentinel_local.db
POSTGRES_DB=cloudsentinel
POSTGRES_USER=cloudsentinel
POSTGRES_PASSWORD=change_me_local_dev_only
DATABASE_URL=postgresql+asyncpg://cloudsentinel:change_me_local_dev_only@localhost:5432/cloudsentinel

# Redis 7+ (broker, result backend, cache)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# OIDC / JWT Authentication
OIDC_ISSUER_URL=https://auth.cloudsentinel.local
OIDC_JWKS_URL=
OIDC_AUDIENCE=cloudsentinel-api
OIDC_LEEWAY_SECONDS=30
# Local development/test HS256 signing key (strictly disabled when CLOUDSENTINEL_ENV=production)
CLOUDSENTINEL_DEV_JWT_SECRET=

# Safe Remediation Controls (Read-Only / Dry-Run by Default)
CLOUDSENTINEL_LIVE_REMEDIATION_ENABLED=false
CLOUDSENTINEL_REMEDIATION_AWS_ROLE_ARN=

# Frontend (Vite build/runtime API target)
VITE_API_BASE_URL=http://localhost:8000
